{% comment %}
  Bow and Bloom homepage hero, in two layouts:
  - Framed: the photo sits in a rounded frame with bow-print wrapping paper behind
    it, beside (desktop) or under (phones) the headline and button.
  - Banner: the photo fills the right of the screen to its edge on desktop and the
    full width above the headline on phones.
  Both carry the headline (optionally ending in changing words, snippets/bb-rotator),
  the berry buy button with the live price, trust points, a slowly turning price
  badge, floating bows and a pause button that stops every looping animation.
  On the first visit of a browser session the wrapping opens: a big bow ties itself,
  the ribbons unroll, the paper parts and the bow settles above the headline.
  snippets/scripts.liquid flags the visit in <head>; assets/bow-and-bloom.js runs the
  words, the pause button, the skip and the floating phone button.
  Without JavaScript, or with reduced motion, everything shows still and complete.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign product = s.product
  assign layout = s.layout | default: 'framed'

  assign button_url = s.button_link
  if button_url == blank and product != blank
    assign button_url = product.url
  endif

  assign price = ''
  if s.show_price and product != blank
    assign price = product.price | money_without_trailing_zeros
  endif

  assign raw_points = s.trust | newline_to_br | split: '<br />'

  assign show_intro = false
  if s.intro and request.design_mode == false
    assign show_intro = true
  endif

  assign image_alt = s.image.alt | default: s.image_alt

  if layout == 'banner'
    assign image_sizes = '(min-width: 750px) 58vw, 100vw'
    assign image_widths = '480, 720, 960, 1200, 1500'
  elsif s.image_ratio == 'landscape'
    assign image_sizes = '(min-width: 750px) 52vw, calc(100vw - 32px)'
    assign image_widths = '480, 720, 960, 1200, 1500'
  else
    assign image_sizes = '(min-width: 750px) min(40vw, 520px), calc(100vw - 32px)'
    assign image_widths = '400, 600, 800, 1000, 1200'
  endif
-%}

{%- capture floating_bows -%}
  {%- if s.show_bows -%}
    {%- for i in (1..5) -%}
      <span
        class="bb-float bb-hero__float--{{ i }}"
        aria-hidden="true"
      ></span>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<div
  id="BbHero-{{ section.id }}"
  class="section bb-hero bb-hero--{{ layout }} bb-hero--{{ s.image_ratio | default: 'landscape' }} color-{{ s.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: s %}"
  data-pause-label="{{ s.pause_label | escape }}"
  data-play-label="{{ s.play_label | escape }}"
>
  <div class="bb-hero__inner">
    <div class="bb-hero__text">
      {%- if layout == 'banner' -%}
        {{ floating_bows }}
      {%- endif -%}
      <span
        class="bb-hero__bow"
        aria-hidden="true"
      ></span>

      <h1 class="bb-hero__title">
        <span
          class="bb-hero__lead"
          data-bb-enter
          style="--d: 0.05s;"
          >{{- s.heading_lead | escape -}}</span
        >
        {%- if s.words != blank -%}
          {% render 'bb-rotator', words: s.words, seconds: s.word_seconds %}
        {%- endif -%}
      </h1>

      {%- if s.subline != blank -%}
        <p
          class="bb-hero__sub"
          data-bb-enter
          style="--d: 0.35s;"
        >
          {{ s.subline | escape }}
        </p>
      {%- endif -%}

      {%- if button_url != blank -%}
        <div
          class="bb-hero__actions"
          data-bb-enter
          style="--d: 0.5s;"
        >
          {% render 'bb-cta', url: button_url, label: s.button_label, price: price, class: 'bb-cta--full bb-cta--hero' %}
        </div>
      {%- endif -%}

      <ul
        class="bb-hero__trust"
        role="list"
      >
        {%- for raw_point in raw_points -%}
          {%- assign point = raw_point | strip -%}
          {%- if point != blank -%}
            <li
              data-bb-enter
              style="--d: {{ forloop.index0 | times: 0.08 | plus: 0.65 }}s;"
            >
              {{ point | escape }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="bb-hero__media">
      <div class="bb-hero__frame">
        {%- if s.image != blank -%}
          {%- if button_url != blank -%}
            <a
              href="{{ button_url }}"
              class="bb-hero__image-link"
              tabindex="-1"
              aria-hidden="true"
            >
          {%- endif -%}
          {{
            s.image
            | image_url: width: 1600
            | image_tag:
              class: 'bb-hero__image',
              widths: image_widths,
              sizes: image_sizes,
              loading: 'eager',
              fetchpriority: 'high',
              alt: image_alt
          }}
          {%- if button_url != blank -%}
            </a>
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'bb-hero__image bb-hero__placeholder' }}
        {%- endif -%}
      </div>

      {%- if s.show_badge -%}
        <div
          class="bb-badge"
          aria-hidden="true"
        >
          <svg
            class="bb-badge__ring"
            viewBox="0 0 120 120"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <path
                id="BbBadgePath-{{ section.id }}"
                d="M60 60m-45 0a45 45 0 1 1 90 0a45 45 0 1 1-90 0"
              />
            </defs>
            <text>
              <textPath
                href="#BbBadgePath-{{ section.id }}"
                textLength="281"
                lengthAdjust="spacing"
              >
                {{- s.badge_text | upcase | escape -}}
              </textPath>
            </text>
          </svg>
          <span class="bb-badge__centre">
            <span class="bb-badge__bow"></span>
            {%- if price != blank -%}
              <span class="bb-badge__price">{{ price }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- if layout != 'banner' -%}
        {{ floating_bows }}
      {%- endif -%}

      <button
        type="button"
        class="bb-motion-toggle"
        aria-pressed="false"
        aria-label="{{ s.pause_label | escape }}"
        title="{{ s.pause_label | escape }}"
      >
        <svg
          class="bb-motion-toggle__pause"
          viewBox="0 0 20 20"
          focusable="false"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M7 5v10M13 5v10" />
        </svg>
        <svg
          class="bb-motion-toggle__play"
          viewBox="0 0 20 20"
          focusable="false"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M7.5 5.2v9.6l7.4-4.8z" />
        </svg>
      </button>
    </div>
  </div>
</div>

{%- if s.close_up_next -%}
  {%- comment -%}
    When the next photo on the page is this same one, show it as a close-up so the
    page doesn't repeat itself (until a real close-up photo is uploaded).
  {%- endcomment -%}
  <style>
    #shopify-section-{{ section.id }} ~ .shopify-section .media-with-content .media-block img {
      --bb-unwrap-scale: 1.85;
      object-position: {{ s.close_up_focus | default: '30% 60%' }};
      transform-origin: {{ s.close_up_focus | default: '30% 60%' }};
      scale: 1.6;
    }
  </style>
{%- endif -%}

{%- if s.floating_button and button_url != blank -%}
  {% render 'bb-cta', url: button_url, label: s.button_label, price: price, class: 'bb-float-cta' %}
{%- endif -%}

{%- if show_intro -%}
  {%- comment -%}
    The first-visit intro. It runs only when <head> flagged this visit (first of the
    session, motion allowed) and the page arrived quickly enough to play it from the start.
    The bow then flies to the small bow above the headline.
  {%- endcomment -%}
  <script>
    (function () {
      var root = document.documentElement;
      var pending = root.classList.contains('bb-intro-pending');
      root.classList.remove('bb-intro-pending');
      if (!pending || performance.now() > 2500) return;
      var hero = document.getElementById('BbHero-{{ section.id }}');
      if (!hero) return;
      try {
        sessionStorage.setItem('bb-intro', '1');
      } catch (error) {}
      hero.setAttribute('data-intro', 'on');
      root.classList.add('bb-intro-playing');

      var target = hero.querySelector('.bb-hero__bow');
      var width = Math.min(window.innerWidth * 0.64, 320);
      var centreX = window.innerWidth / 2;
      var centreY = window.innerHeight / 2 + width * 0.081;
      if (target && window.scrollY === 0) {
        var box = target.getBoundingClientRect();
        root.style.setProperty('--bb-fly-x', box.left + box.width / 2 - centreX + 'px');
        root.style.setProperty('--bb-fly-y', box.top + box.height / 2 - centreY + 'px');
        root.style.setProperty('--bb-fly-scale', String(box.width / width));
      }
    })();
  </script>
  <div
    class="bb-intro color-{{ s.color_scheme }}"
    aria-hidden="true"
  >
    <div class="bb-intro__half bb-intro__half--start"><span class="bb-intro__ribbon"></span></div>
    <div class="bb-intro__half bb-intro__half--end"><span class="bb-intro__ribbon"></span></div>
    <span class="bb-intro__vribbon"></span>
    <div class="bb-intro__bow">
      {% render 'bow', style: 'line', class: 'bb-intro__bow-line' %}
      {% render 'bow', class: 'bb-intro__bow-fill' %}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ---------- Layout ---------- */

  .bb-hero {
    --bb-hero-delay: 0.1s;
    --bb-frame-radius: 22px;

    overflow-x: clip;
  }

  .bb-hero__inner {
    display: grid;
    gap: 2.25rem;
    padding-block: 1.6rem 3.25rem;
  }

  @media screen and (min-width: 750px) {
    .bb-hero {
      --bb-frame-radius: 30px;
    }

    .bb-hero__inner {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      align-items: center;
      gap: clamp(2.5rem, 5vw, 5.5rem);
      min-block-size: min(calc(100svh - 110px), 760px);
      padding-block: 2.5rem 4rem;
    }
  }

  .bb-hero__text {
    position: relative;
    z-index: 2;
  }

  /* ---------- Headline ---------- */

  .bb-hero__bow {
    display: block;
    inline-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    aspect-ratio: 80 / 48;
    margin-block-end: 0.9rem;
    background-color: var(--color-primary);
    mask: var(--bb-bow) center / contain no-repeat;
    transform-origin: 50% 40%;
  }

  .bb-hero__title {
    container-type: inline-size;
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.55rem, 1.55rem + 4.1vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    color: var(--color-foreground-heading);
  }

  .bb-hero__lead {
    display: block;
    text-wrap: balance;
  }

  .bb-hero__sub {
    max-inline-size: 34ch;
    margin-block: 1.15rem 1.6rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .bb-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.3rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .bb-hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bb-hero__trust li::before {
    content: '';
    flex: none;
    inline-size: 1.15em;
    aspect-ratio: 80 / 48;
    background-color: var(--color-primary);
    mask: var(--bb-bow) center / contain no-repeat;
  }

  /* ---------- Framed photo, wrapping paper, badge and bows ---------- */

  .bb-hero__media {
    position: relative;
    margin-inline-end: 8px;
  }

  /* Wrapping paper peeking out from behind the photo: a petal sheet with a bow print. */
  .bb-hero--framed .bb-hero__media::before,
  .bb-hero--framed .bb-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--bb-frame-radius);
    translate: 10px 10px;
    rotate: 2deg;
  }

  .bb-hero--framed .bb-hero__media::before {
    background-color: color-mix(in srgb, var(--color-primary) 18%, var(--color-background));
  }

  .bb-hero--framed .bb-hero__media::after {
    background-color: rgb(var(--color-foreground-rgb) / 0.11);
    mask: var(--bb-pattern) 0 0 / 88px repeat;
  }

  .bb-hero__frame {
    position: relative;
    z-index: 1;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--bb-frame-radius);
    background: var(--color-background);
    box-shadow: 0 34px 60px -34px rgb(var(--color-shadow-rgb) / 0.55);
  }

  .bb-hero--framed.bb-hero--portrait .bb-hero__frame {
    aspect-ratio: 4 / 5;
  }

  .bb-hero--framed.bb-hero--square .bb-hero__frame {
    aspect-ratio: 1;
  }

  @media screen and (min-width: 750px) {
    .bb-hero__media {
      margin-inline-end: 0;
    }

    .bb-hero--framed .bb-hero__media::before,
    .bb-hero--framed .bb-hero__media::after {
      translate: 18px 18px;
      rotate: 2.5deg;
    }

    /* Upright photos keep to the screen height and sit centred in their column. */
    .bb-hero--framed.bb-hero--portrait .bb-hero__media {
      justify-self: center;
      inline-size: min(100%, calc(min(72svh, 620px) * 0.8));
    }

    .bb-hero--framed.bb-hero--square .bb-hero__media {
      justify-self: center;
      inline-size: min(100%, min(72svh, 600px));
    }
  }

  .bb-hero__image-link {
    display: block;
    block-size: 100%;
  }

  .bb-hero__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* ---------- Banner: the photo fills the right of the screen (phones: the top) ---------- */

  .bb-hero--banner .bb-hero__inner {
    grid-column: 1 / -1;
    gap: 0;
    padding-block: 0;
  }

  .bb-hero--banner .bb-hero__media {
    order: -1;
    margin: 0;
  }

  .bb-hero--banner .bb-hero__frame {
    border-radius: 0;
    box-shadow: none;
  }

  .bb-hero--banner .bb-hero__text {
    padding: 1.6rem var(--page-margin) 2.75rem;
  }

  @media screen and (min-width: 750px) {
    .bb-hero--banner .bb-hero__inner {
      grid-template-columns: minmax(0, 2.5fr) minmax(0, 3.5fr);
      align-items: stretch;
      min-block-size: 0;
    }

    .bb-hero--banner .bb-hero__media {
      order: 0;
    }

    .bb-hero--banner .bb-hero__frame {
      block-size: 100%;
    }

    .bb-hero--banner .bb-hero__text {
      align-self: center;
      padding-block: 3rem;
      padding-inline: var(--util-page-margin-offset, 40px) clamp(2rem, 4vw, 4.5rem);
    }

    /* The narrower column reads better with the trust points stacked, as in v3. */
    .bb-hero--banner .bb-hero__trust {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  /* ---------- Price badge ---------- */

  .bb-badge {
    position: absolute;
    z-index: 3;
    inset-block-end: -2.6rem;
    inset-inline-end: 0.9rem;
    display: grid;
    place-items: center;
    inline-size: 6.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--color-foreground-heading);
    background: var(--color-background);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-primary) 35%, transparent),
      0 16px 30px -18px rgb(var(--color-shadow-rgb) / 0.6);
  }

  .bb-hero--banner .bb-badge {
    inset-block-end: 0.9rem;
    inline-size: 5.6rem;
  }

  @media screen and (min-width: 750px) {
    .bb-badge {
      inset-block-end: -3rem;
      inset-inline-start: -3rem;
      inset-inline-end: auto;
      inline-size: 8.4rem;
    }

    /* On the banner the badge sits on the seam between the words and the photo. */
    .bb-hero--banner .bb-badge {
      inset-block-end: 2.75rem;
      inset-inline-start: -4.2rem;
      inline-size: 8.4rem;
    }
  }

  .bb-badge__ring {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .bb-badge__ring text {
    font-family: var(--font-body--family);
    font-size: 10.2px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: currentcolor;
  }

  .bb-badge__centre {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
  }

  .bb-badge__bow {
    inline-size: 1.5rem;
    aspect-ratio: 80 / 48;
    background-color: var(--color-primary);
    mask: var(--bb-bow) center / contain no-repeat;
  }

  .bb-badge__price {
    font-family: var(--font-heading--family);
    font-size: 1.55rem;
    line-height: 1;
  }

  .bb-hero--banner .bb-badge__bow {
    inline-size: 1.25rem;
  }

  .bb-hero--banner .bb-badge__price {
    font-size: 1.35rem;
  }

  @media screen and (min-width: 750px) {
    .bb-badge__price,
    .bb-hero--banner .bb-badge__price {
      font-size: 1.9rem;
    }

    .bb-hero--banner .bb-badge__bow {
      inline-size: 1.5rem;
    }
  }

  /* ---------- Floating bows (assets/bow-and-bloom.css: .bb-float) ---------- */

  .bb-hero__float--1 { --size: 2.6rem; --alpha: 0.55; --r: -14deg; inset-block-start: -1.4rem; inset-inline-start: 12%; }
  .bb-hero__float--2 { --size: 1.4rem; --alpha: 0.4; --r: 18deg; inset-block-start: 18%; inset-inline-end: -0.6rem; --k: 1; }
  .bb-hero__float--3 { --size: 1.9rem; --alpha: 0.35; --r: 10deg; inset-block-end: 24%; inset-inline-start: -0.9rem; --k: 2; }
  .bb-hero__float--4 { --size: 1.1rem; --alpha: 0.45; --r: 24deg; inset-block-start: -0.6rem; inset-inline-end: 22%; --k: 3; }
  .bb-hero__float--5 { --size: 1.6rem; --alpha: 0.3; --r: -20deg; inset-block-end: -1.6rem; inset-inline-start: 38%; --k: 4; }

  /* On the banner the bows drift in the space beside the headline, never over the photo. */
  .bb-hero--banner .bb-hero__float--1 { inset: 1.4rem 6% auto auto; --size: 2.2rem; }
  .bb-hero--banner .bb-hero__float--2 { inset: 34% 3% auto auto; --size: 1.25rem; }
  .bb-hero--banner .bb-hero__float--3 { inset: auto 14% 16% auto; --size: 1.6rem; }
  .bb-hero--banner .bb-hero__float--4 { inset: 3.4rem 24% auto auto; --size: 1rem; }
  .bb-hero--banner .bb-hero__float--5 { display: none; }

  .bb-hero .bb-float {
    --bb-float-delay: calc(var(--bb-hero-delay) + 0.6s);
  }

  @media screen and (max-width: 749px) {
    .bb-hero__float--3,
    .bb-hero__float--5 {
      display: none;
    }

    /* Phones: two small bows in the corner above the headline, clear of the words. */
    .bb-hero--banner .bb-hero__float--1 {
      inset: 1rem 5% auto auto;
      --size: 1.8rem;
    }

    .bb-hero--banner .bb-hero__float--2 {
      display: none;
    }

    .bb-hero--banner .bb-hero__float--4 {
      inset: 2.6rem 22% auto auto;
    }
  }

  /* ---------- Pause button: stops every looping animation on the page (WCAG 2.2.2) ---------- */

  .bb-motion-toggle {
    position: absolute;
    z-index: 3;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--color-foreground-heading);
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(6px);
    box-shadow: 0 6px 16px -10px rgb(var(--color-shadow-rgb) / 0.8);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.2s, scale 0.2s;
  }

  .bb-motion-toggle:hover {
    opacity: 1;
    scale: 1.06;
  }

  .bb-motion-toggle:focus-visible {
    outline: 2px solid var(--color-foreground-heading);
    outline-offset: 2px;
    opacity: 1;
  }

  .bb-motion-toggle svg {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bb-motion-toggle__play {
    display: none;
    fill: currentcolor !important;
  }

  .bb-motion-toggle[aria-pressed='true'] .bb-motion-toggle__pause {
    display: none;
  }

  .bb-motion-toggle[aria-pressed='true'] .bb-motion-toggle__play {
    display: block;
  }

  /* Nothing loops for people who asked for less motion, so the button isn't needed. */
  @media (prefers-reduced-motion: reduce) {
    .bb-motion-toggle {
      display: none;
    }
  }

  /* ---------- Entrance on every visit ---------- */

  @media (prefers-reduced-motion: no-preference) {
    .bb-hero__bow {
      animation: bb-tie 0.9s var(--bb-ease-out) var(--bb-hero-delay) both;
    }

    .bb-hero [data-bb-enter] {
      animation: bb-rise 0.9s var(--bb-ease-out) both;
      animation-delay: calc(var(--bb-hero-delay) + var(--d, 0s));
    }

    .bb-hero .bb-rotator__word--first {
      --bb-word-delay: calc(var(--bb-hero-delay) + 0.2s);
    }

    .bb-hero--framed .bb-hero__frame {
      animation: bb-frame-in 1.3s var(--bb-ease-out) var(--bb-hero-delay) both;
    }

    .bb-hero__image {
      animation: bb-image-settle 1.8s var(--bb-ease-out) var(--bb-hero-delay) both;
    }

    .bb-hero--framed .bb-hero__media::before,
    .bb-hero--framed .bb-hero__media::after {
      animation: bb-paper-in 1.3s var(--bb-ease-tie) calc(var(--bb-hero-delay) + 0.25s) both;
    }

    .bb-badge {
      animation: bb-badge-in 0.9s var(--bb-ease-tie) calc(var(--bb-hero-delay) + 0.75s) both;
    }

    .bb-badge__ring {
      animation: bb-spin 24s linear infinite;
    }

    /* After the intro the bow above the headline appears where the big bow lands. */
    .bb-hero[data-intro='on'] {
      --bb-hero-delay: 1.5s;
    }

    .bb-hero[data-intro='on'] .bb-hero__bow {
      animation: bb-appear 0.01s linear 2.04s both;
    }

    .bb-hero[data-intro='skipped'] {
      --bb-hero-delay: 0s;
    }
  }

  @keyframes bb-frame-in {
    from {
      scale: 0.96;
      translate: 0 18px;
    }
  }

  @keyframes bb-image-settle {
    from {
      scale: 1.1;
    }
  }

  @keyframes bb-paper-in {
    from {
      translate: 0 0;
      rotate: 0deg;
    }
  }

  @keyframes bb-badge-in {
    from {
      opacity: 0;
      scale: 0.4;
      rotate: -40deg;
    }
  }

  @keyframes bb-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes bb-appear {
    from {
      opacity: 0;
    }
  }
{% endstylesheet %}

