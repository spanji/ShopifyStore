              "blocks": {
                "faq_1_text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Order by 12pm Monday to Saturday and we'll post it the same day. Free tracked delivery usually takes 2–5 working days, or choose next day at checkout for £2.99.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
